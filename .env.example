# 复制为 .env 后在服务器配置；真实 .env 不提交版本管理。
APP_ENV=development
DEPLOYMENT_MODE=native
APP_HOST=127.0.0.1
APP_PORT=8000
ENABLE_PAID_MODEL_CALLS=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_MAX_RETRIES=1
DASHSCOPE_TIMEOUT_SECONDS=20
DATABASE_URL=postgresql+asyncpg://bankapp:REPLACE_ME@127.0.0.1:15432/bank
REDIS_URL=redis://:REPLACE_ME@127.0.0.1:16379/0
CACHE_PREFIX=bank:v1
CONTEXT_TTL_SECONDS=1800
CONTEXT_MESSAGE_LIMIT=12
SKILLS_DIR=skills
SKILLS_MAX_PROMPT_CHARS=5000
MEMORY_ENABLED=true
MEMORY_TENANT_ID=demo
MEMORY_SUMMARY_COLLECTION=conversation_summaries_v1
MEMORY_PROFILE_COLLECTION=user_profiles_v1
MEMORY_SUMMARY_THRESHOLD_MESSAGES=12
MEMORY_SUMMARY_INCREMENT_MESSAGES=8
MEMORY_RETRIEVAL_TOP_K=3
WORKER_STREAM_MAXLEN=10000
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1
CHAT_RATE_LIMIT_PER_MINUTE=30
MEMORY_EMBEDDING_DAILY_LIMIT=500
TOKEN_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=10485760
MCP_HOST=127.0.0.1
MCP_PORT=8002
MCP_URL=http://127.0.0.1:8002/mcp
MCP_TIMEOUT_SECONDS=15
MCP_MAX_RETRIES=1
MCP_CACHE_TTL_SECONDS=300
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_COOLDOWN_SECONDS=30
CHAT_RETRIEVAL_TOP_K=4
INTENT_CONFIDENCE_THRESHOLD=0.58
CONTEXT_REWRITE_MAX_MESSAGES=6
REACT_ENABLED=true
REACT_MAX_STEPS=3
REACT_MAX_TOOL_CALLS=3
REACT_TIMEOUT_SECONDS=15
REACT_MAX_EVIDENCE=8
INGESTION_JOB_MAX_BYTES=10485760
CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=bank_knowledge_v1
CHROMA_PATH=var/chroma
