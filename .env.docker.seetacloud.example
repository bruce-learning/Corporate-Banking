# SeetaCloud 受限容器宿主机使用 host 网络；所有服务仅绑定回环地址。
APP_ENV=production
DEPLOYMENT_MODE=container
APP_HOST=127.0.0.1
APP_PORT=18000
DOCKER_APP_PORT=18000

ENABLE_PAID_MODEL_CALLS=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_MAX_RETRIES=1
DASHSCOPE_TIMEOUT_SECONDS=20
DASHSCOPE_TRUST_ENV=false

POSTGRES_DB=bank
POSTGRES_USER=bankapp
POSTGRES_PASSWORD=REPLACE_ME_WITH_HEX_PASSWORD
DATABASE_URL=postgresql+asyncpg://bankapp:REPLACE_ME_WITH_HEX_PASSWORD@127.0.0.1:25432/bank

REDIS_PASSWORD=REPLACE_ME_WITH_HEX_PASSWORD
REDIS_URL=redis://:REPLACE_ME_WITH_HEX_PASSWORD@127.0.0.1:26379/0
CACHE_PREFIX=bank:docker:v1

MCP_HOST=127.0.0.1
MCP_PORT=28002
MCP_URL=http://127.0.0.1:28002/mcp
MCP_TIMEOUT_SECONDS=15
MCP_MAX_RETRIES=1
MCP_CACHE_TTL_SECONDS=300
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_COOLDOWN_SECONDS=30

ORCHESTRATION_BACKEND=langgraph
LANGGRAPH_RECURSION_LIMIT=30
REACT_ENABLED=true
REACT_MAX_STEPS=3
REACT_MAX_TOOL_CALLS=3
REACT_TIMEOUT_SECONDS=15
REACT_MAX_EVIDENCE=8

CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=28001
CHROMA_COLLECTION=bank_knowledge_v1
CHROMA_PATH=var/chroma

DATA_DIR=var/data
LOG_DIR=var/logs
SKILLS_DIR=skills
MEMORY_ENABLED=true
MEMORY_TENANT_ID=demo
TOKEN_TTL_SECONDS=3600
CONTEXT_TTL_SECONDS=1800
CONTEXT_MESSAGE_LIMIT=12
CHAT_RATE_LIMIT_PER_MINUTE=30
MEMORY_EMBEDDING_DAILY_LIMIT=500
MAX_UPLOAD_BYTES=10485760
INGESTION_JOB_MAX_BYTES=10485760
